# Lenovo TB3-710F / MT8127 XNU profile.
# Requires a flat ARMv7 Mach-O at blob/Image, an Apple-format device tree at
# blob/dtb, and a gzip-compressed HFS+ root image at blob/ramdisk.
CONFIG_TEXT_BASE=0x80008000
CONFIG_PAYLOAD_ENTRY=0x82000000
CONFIG_RAMDISK_ENTRY=0x84000000
CONFIG_COMPRESS_GZIP=n
CONFIG_EMBED_LINUX=n
CONFIG_EMBED_XNU=y
CONFIG_XNU_BLOB_LZ4=n
CONFIG_XNU_ENTRY_OFFSET=0x0
CONFIG_XNU_PHYS_BASE=0x80000000
CONFIG_XNU_VIRT_BASE=0x80000000
CONFIG_XNU_MEMSIZE=0x3ED00000
CONFIG_XNU_RAMDISK_PA=0x90000000
CONFIG_XNU_FB_BASE=0xBEE00000
CONFIG_XNU_FB_WIDTH=1024
CONFIG_XNU_FB_HEIGHT=600
CONFIG_XNU_FB_DEPTH=16
CONFIG_XNU_FB_ROW_BYTES=0x800
CONFIG_XNU_CMDLINE="-v keepsyms=1 debug=0x14e rd=md0"
CONFIG_XNU_CACHESLICE_TOP=0xBED00000
CONFIG_XNU_CACHESLICE_BASE=0x90000000
# No iOS dyld shared cache is embedded for the initial kernel bring-up.
CONFIG_XNU_EMBED_CACHESLICE=n
CONFIG_MT8127=y
CONFIG_LENOVO_TB3_710F=y
# CONFIG_LENOVO_TB3_710F_FB_SMOKE is not set

