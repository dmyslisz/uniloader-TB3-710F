diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7TB3MSDC.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7TB3MSDC.cpp
new file mode 100644
index 0000000..0ec39ca
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7TB3MSDC.cpp
@@ -0,0 +1,578 @@
+/* Read-only PIO storage for Lenovo TB3-710F / MT8127 MSDC0 eMMC and MSDC1 SD.
+ * MSDC0 relies on the LK eMMC pin setup; MSDC1 configures the external SD pins.
+ * Opt in with tb3_emmc=1 or tb3_sd=1. This driver never writes to media.
+ */
+#if defined(BOARD_CONFIG_MT8127_TB3)
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include <IOKit/storage/IOStorage.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOCatalogue.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/debug.h>
+#include "IOS7LabStoragePersonalities.h"
+
+extern "C" int PE_parse_boot_argn(const char *, void *, int);
+
+#define TB3_MSDC_PA          0x11230000U
+#define TB3_MSDC1_PA         0x11240000U
+#define TB3_MSDC_BYTES       0x1000U
+#define TB3_PERICFG_PA       0x10003000U
+#define TB3_PERICFG_BYTES    0x100U
+#define TB3_GPIO_PA          0x10005000U
+#define TB3_GPIO_BYTES       0x1000U
+#define TB3_PERI_PDN0_CLR    0x010U
+#define TB3_MSDC_GATE_BIT    (1U << 13)
+#define TB3_MSDC1_GATE_BIT   (1U << 14)
+#define TB3_MSDC_HCLK_HZ     200000000U
+#define TB3_MSDC_CMD_LIMIT   1000000U
+#define TB3_MSDC_DATA_LIMIT  2000000U
+
+#define R_MSDC_CFG           0x000U
+#define R_MSDC_IOCON         0x004U
+#define R_MSDC_INT           0x00cU
+#define R_MSDC_INTEN         0x010U
+#define R_MSDC_FIFOCS        0x014U
+#define R_MSDC_RXDATA        0x01cU
+#define R_RXDATA             R_MSDC_RXDATA
+#define R_SDC_CFG            0x030U
+#define R_SDC_CMD            0x034U
+#define R_SDC_ARG            0x038U
+#define R_SDC_STS            0x03cU
+#define R_SDC_RESP0          0x040U
+#define R_SDC_BLK_NUM        0x050U
+#define R_SDC_CSTS           0x058U
+#define INT_CMDRDY           (1U << 8)
+#define INT_CMDTMO           (1U << 9)
+#define INT_RSPCRCERR        (1U << 10)
+#define INT_XFER_COMPL       (1U << 12)
+#define INT_DATTMO           (1U << 14)
+#define INT_DATCRCERR        (1U << 15)
+#define CFG_MODE             (1U << 0)
+#define CFG_RST              (1U << 2)
+#define CFG_PIO              (1U << 3)
+#define CFG_CKSTB             (1U << 7)
+#define CFG_CKDIV_MASK       (0xffU << 8)
+#define CFG_CKMOD_MASK       (3U << 16)
+#define CFG_CKMOD_SHIFT      16
+#define FIFO_CLR             (1U << 31)
+#define FIFO_RXCNT_MASK      0xffU
+#define SDC_BUSY             (1U << 0)
+#define SDC_CMDBUSY          (1U << 1)
+#define SDC_BUSWIDTH_MASK    (3U << 16)
+#define SDC_DTOC_MASK        (0xffU << 24)
+#define SDC_DTYP_SINGLE      (1U << 11)
+#define SDC_BLKLEN_512       (512U << 16)
+#define RSP_NONE             0U
+#define RSP_R1               1U
+#define RSP_R2               2U
+#define RSP_R3               3U
+#define RSP_R1B              7U
+#define CMD0_GO_IDLE         0U
+#define CMD1_SEND_OP_COND    1U
+#define CMD2_ALL_SEND_CID    2U
+#define CMD3_SET_RCA         3U
+#define CMD7_SELECT_CARD     7U
+#define CMD8_SEND_EXT_CSD    8U
+#define CMD9_SEND_CSD        9U
+#define CMD16_SET_BLOCKLEN   16U
+#define CMD13_SEND_STATUS    13U
+#define CMD17_READ_SINGLE    17U
+#define CMD55_APP_CMD        55U
+#define ACMD41_SD_SEND_OP_COND 41U
+
+#define super IOBlockStorageDevice
+class IOS7TB3MSDC : public IOBlockStorageDevice {
+    OSDeclareDefaultStructors(IOS7TB3MSDC)
+
+    IOMemoryDescriptor *msdcDesc;
+    IOMemoryDescriptor *periDesc;
+    IOMemoryDescriptor *gpioDesc;
+    IOMemoryMap *msdcMap;
+    IOMemoryMap *periMap;
+    IOMemoryMap *gpioMap;
+    volatile UInt32 *regs;
+    volatile UInt32 *peri;
+    volatile UInt8 *gpio;
+    IOLock *lock;
+    UInt64 sectors;
+    UInt32 rca;
+    bool initialized;
+    bool faulted;
+    bool sdCard;
+    bool highCapacity;
+
+    UInt32 readReg(UInt32 offset) {
+        OSSynchronizeIO();
+        return regs[offset / 4U];
+    }
+    void writeReg(UInt32 offset, UInt32 value) {
+        regs[offset / 4U] = value;
+        OSSynchronizeIO();
+    }
+    void delayUS(UInt32 us) { IODelay(us); }
+    IOReturn setClock(UInt32 hz);
+    IOReturn command(UInt32 opcode, UInt32 argument, UInt32 responseType,
+                     UInt32 response[4]);
+    IOReturn dataCommand(UInt32 opcode, UInt32 argument, UInt32 responseType,
+                         UInt8 *bytes, UInt32 length);
+    IOReturn initializeCard();
+    IOReturn readSector(UInt64 sector, UInt8 *bytes);
+    void configureSDPins();
+
+public:
+    void selectSDCard() { sdCard = true; }
+    virtual bool init(OSDictionary *properties = 0);
+    virtual bool start(IOService *provider);
+    virtual void free();
+    virtual IOReturn doAsyncReadWrite(IOMemoryDescriptor *, UInt64, UInt64,
+                                     IOStorageAttributes *, IOStorageCompletion *);
+    virtual IOReturn doEjectMedia() { return kIOReturnUnsupported; }
+    virtual IOReturn doFormatMedia(UInt64) { return kIOReturnUnsupported; }
+    virtual UInt32 doGetFormatCapacities(UInt64 *, UInt32) const { return 0; }
+    virtual IOReturn doLockUnlockMedia(bool) { return kIOReturnUnsupported; }
+    virtual IOReturn doSynchronizeCache() { return initialized ? kIOReturnSuccess : kIOReturnNotReady; }
+    virtual char *getVendorString();
+    virtual char *getProductString();
+    virtual char *getRevisionString();
+    virtual char *getAdditionalDeviceInfoString();
+    virtual IOReturn reportBlockSize(UInt64 *);
+    virtual IOReturn reportMaxValidBlock(UInt64 *);
+    virtual IOReturn reportEjectability(bool *);
+    virtual IOReturn reportLockability(bool *);
+    virtual IOReturn reportRemovability(bool *);
+    virtual IOReturn reportMediaState(bool *, bool *);
+    virtual IOReturn reportPollRequirements(bool *, bool *);
+    virtual IOReturn reportWriteProtection(bool *);
+};
+
+OSDefineMetaClassAndStructors(IOS7TB3MSDC, IOBlockStorageDevice)
+
+bool IOS7TB3MSDC::init(OSDictionary *properties)
+{
+    if (!IOBlockStorageDevice::init(properties)) return false;
+    msdcDesc = periDesc = gpioDesc = 0;
+    msdcMap = periMap = gpioMap = 0;
+    regs = peri = 0;
+    gpio = 0;
+    lock = 0;
+    sectors = 0;
+    rca = 0;
+    initialized = false;
+    faulted = false;
+    sdCard = false;
+    highCapacity = false;
+    return true;
+}
+
+void IOS7TB3MSDC::configureSDPins()
+{
+    /* MT8127 board table: GPIO121..126 are MSDC1 CMD/CLK/DAT0..3 on mode 1.
+     * Keep the board's pull-up on CMD/DAT and pull-down on CLK. */
+    for (UInt32 pin = 121U; pin <= 126U; ++pin) {
+        UInt32 group = pin / 5U;
+        UInt32 shift = (pin % 5U) * 3U;
+        volatile UInt16 *mode = (volatile UInt16 *)(gpio + 0x600U + group * 0x10U);
+        UInt16 modeValue = *mode;
+        modeValue = (UInt16)((modeValue & ~(7U << shift)) | (1U << shift));
+        *mode = modeValue;
+
+        UInt32 pullGroup = pin / 16U;
+        UInt16 bit = (UInt16)(1U << (pin % 16U));
+        volatile UInt16 *pullEnableSet = (volatile UInt16 *)(gpio +
+            0x104U + pullGroup * 0x10U);
+        volatile UInt16 *pullSelectSet = (volatile UInt16 *)(gpio +
+            0x204U + pullGroup * 0x10U);
+        volatile UInt16 *pullSelectReset = (volatile UInt16 *)(gpio +
+            0x208U + pullGroup * 0x10U);
+        *pullEnableSet = bit;
+        if (pin == 122U) *pullSelectReset = bit;
+        else *pullSelectSet = bit;
+    }
+    OSSynchronizeIO();
+    delayUS(10U);
+}
+
+bool IOS7TB3MSDC::start(IOService *provider)
+{
+    if (!IOBlockStorageDevice::start(provider)) return false;
+
+    lock = IOLockAlloc();
+    UInt32 controllerPA = sdCard ? TB3_MSDC1_PA : TB3_MSDC_PA;
+    UInt32 gateBit = sdCard ? TB3_MSDC1_GATE_BIT : TB3_MSDC_GATE_BIT;
+    msdcDesc = IOMemoryDescriptor::withPhysicalAddress(controllerPA,
+        TB3_MSDC_BYTES, kIODirectionInOut);
+    periDesc = IOMemoryDescriptor::withPhysicalAddress(TB3_PERICFG_PA,
+        TB3_PERICFG_BYTES, kIODirectionInOut);
+    if (sdCard)
+        gpioDesc = IOMemoryDescriptor::withPhysicalAddress(TB3_GPIO_PA,
+            TB3_GPIO_BYTES, kIODirectionInOut);
+    if (!lock || !msdcDesc || !periDesc || (sdCard && !gpioDesc)) return false;
+
+    msdcMap = msdcDesc->map(kIOMapInhibitCache);
+    periMap = periDesc->map(kIOMapInhibitCache);
+    if (sdCard) gpioMap = gpioDesc->map(kIOMapInhibitCache);
+    if (!msdcMap || !periMap || !msdcMap->getAddress() ||
+        !periMap->getAddress() ||
+        (sdCard && (!gpioMap || !gpioMap->getAddress()))) return false;
+    regs = (volatile UInt32 *)msdcMap->getAddress();
+    peri = (volatile UInt32 *)periMap->getAddress();
+    if (sdCard) gpio = (volatile UInt8 *)gpioMap->getAddress();
+
+    /* PERI_PDN0_CLR is write-one-to-clear: enable only the chosen MSDC gate. */
+    peri[TB3_PERI_PDN0_CLR / 4U] = gateBit;
+    OSSynchronizeIO();
+    delayUS(10);
+    if (sdCard) configureSDPins();
+
+    UInt32 version = readReg(0x100U);
+    if (!version || version == 0xffffffffU) {
+        IOLog("TB3 MSDC%u: controller version register unavailable (%08x)\n",
+              sdCard ? 1U : 0U, version);
+        return false;
+    }
+    IOLog("TB3 MSDC%u: controller version=%08x; enabling read-only PIO\n",
+          sdCard ? 1U : 0U, version);
+
+    IOReturn result = initializeCard();
+    if (result != kIOReturnSuccess) {
+        IOLog("TB3 MSDC%u: card initialization failed (%08x)\n",
+              sdCard ? 1U : 0U, (unsigned)result);
+        return false;
+    }
+    initialized = true;
+    IOLog("TB3 MSDC%u: sectors=%llu (512-byte), read-only\n",
+          sdCard ? 1U : 0U, (unsigned long long)sectors);
+    return true;
+}
+
+void IOS7TB3MSDC::free()
+{
+    if (msdcMap) msdcMap->release();
+    if (periMap) periMap->release();
+    if (gpioMap) gpioMap->release();
+    if (msdcDesc) msdcDesc->release();
+    if (periDesc) periDesc->release();
+    if (gpioDesc) gpioDesc->release();
+    if (lock) IOLockFree(lock);
+    IOBlockStorageDevice::free();
+}
+
+IOReturn IOS7TB3MSDC::setClock(UInt32 hz)
+{
+    if (!hz) return kIOReturnBadArgument;
+    UInt32 divisor = (TB3_MSDC_HCLK_HZ + (4U * hz) - 1U) / (4U * hz);
+    if (divisor > 255U) return kIOReturnUnsupported;
+    if (divisor == 0U) divisor = 1U;
+
+    UInt32 cfg = readReg(R_MSDC_CFG);
+    cfg &= ~(CFG_CKDIV_MASK | CFG_CKMOD_MASK);
+    cfg |= (divisor << 8);
+    writeReg(R_MSDC_CFG, cfg);
+    for (UInt32 i = 0; i < 100000U; ++i) {
+        if (readReg(R_MSDC_CFG) & CFG_CKSTB) return kIOReturnSuccess;
+        delayUS(1);
+    }
+    return kIOReturnTimeout;
+}
+
+IOReturn IOS7TB3MSDC::command(UInt32 opcode, UInt32 argument,
+                              UInt32 responseType, UInt32 response[4])
+{
+    for (UInt32 i = 0; i < TB3_MSDC_CMD_LIMIT; ++i) {
+        if (!(readReg(R_SDC_STS) & (SDC_BUSY | SDC_CMDBUSY))) break;
+        if (i + 1U == TB3_MSDC_CMD_LIMIT) return kIOReturnTimeout;
+    }
+
+    UInt32 oldInterrupts = readReg(R_MSDC_INT);
+    writeReg(R_MSDC_INT, oldInterrupts);
+    writeReg(R_SDC_ARG, argument);
+    writeReg(R_SDC_CMD, opcode | (responseType << 7));
+
+    for (UInt32 i = 0; i < TB3_MSDC_CMD_LIMIT; ++i) {
+        UInt32 status = readReg(R_MSDC_INT);
+        if (status & INT_CMDTMO) {
+            writeReg(R_MSDC_INT, INT_CMDTMO);
+            return kIOReturnTimeout;
+        }
+        if (status & INT_RSPCRCERR) {
+            writeReg(R_MSDC_INT, INT_RSPCRCERR);
+            return kIOReturnIOError;
+        }
+        if (status & INT_CMDRDY) {
+            if (response) {
+                if (responseType == RSP_R2) {
+                    response[0] = readReg(0x04cU);
+                    response[1] = readReg(0x048U);
+                    response[2] = readReg(0x044U);
+                    response[3] = readReg(R_SDC_RESP0);
+                } else {
+                    response[0] = readReg(R_SDC_RESP0);
+                    response[1] = readReg(0x044U);
+                    response[2] = readReg(0x048U);
+                    response[3] = readReg(0x04cU);
+                }
+            }
+            writeReg(R_MSDC_INT, INT_CMDRDY);
+            return kIOReturnSuccess;
+        }
+        delayUS(1);
+    }
+    return kIOReturnTimeout;
+}
+
+IOReturn IOS7TB3MSDC::dataCommand(UInt32 opcode, UInt32 argument,
+                                 UInt32 responseType, UInt8 *bytes,
+                                 UInt32 length)
+{
+    if (!bytes || !length || (length & 3U)) return kIOReturnBadArgument;
+    for (UInt32 i = 0; i < TB3_MSDC_CMD_LIMIT; ++i) {
+        if (!(readReg(R_SDC_STS) & (SDC_BUSY | SDC_CMDBUSY))) break;
+        if (i + 1U == TB3_MSDC_CMD_LIMIT) return kIOReturnTimeout;
+    }
+    UInt32 oldInterrupts = readReg(R_MSDC_INT);
+    writeReg(R_MSDC_INT, oldInterrupts);
+    writeReg(R_MSDC_FIFOCS, FIFO_CLR);
+    writeReg(R_SDC_BLK_NUM, 1U);
+    writeReg(R_SDC_ARG, argument);
+    UInt32 raw = opcode | (responseType << 7) | SDC_DTYP_SINGLE |
+                 (length << 16);
+    writeReg(R_SDC_CMD, raw);
+
+    bool commandReady = false;
+    UInt32 transferred = 0;
+    for (UInt32 i = 0; i < TB3_MSDC_DATA_LIMIT; ++i) {
+        UInt32 status = readReg(R_MSDC_INT);
+        if (status & (INT_CMDTMO | INT_RSPCRCERR | INT_DATTMO | INT_DATCRCERR))
+            return (status & (INT_CMDTMO | INT_DATTMO)) ?
+                kIOReturnTimeout : kIOReturnIOError;
+        if (status & INT_CMDRDY) {
+            commandReady = true;
+            writeReg(R_MSDC_INT, INT_CMDRDY);
+        }
+        UInt32 available = readReg(R_MSDC_FIFOCS) & FIFO_RXCNT_MASK;
+        while (available >= 4U && transferred < length) {
+            UInt32 word = readReg(R_RXDATA);
+            bytes[transferred++] = (UInt8)word;
+            bytes[transferred++] = (UInt8)(word >> 8);
+            bytes[transferred++] = (UInt8)(word >> 16);
+            bytes[transferred++] = (UInt8)(word >> 24);
+            available -= 4U;
+        }
+        if (commandReady && transferred == length && (status & INT_XFER_COMPL)) {
+            writeReg(R_MSDC_INT, INT_XFER_COMPL);
+            return kIOReturnSuccess;
+        }
+        delayUS(1);
+    }
+    return kIOReturnTimeout;
+}
+
+IOReturn IOS7TB3MSDC::initializeCard()
+{
+    UInt32 response[4] = {0, 0, 0, 0};
+    UInt8 extCsd[512];
+    UInt32 cfg = readReg(R_MSDC_CFG);
+    writeReg(R_MSDC_CFG, cfg | CFG_RST);
+    bool resetDone = false;
+    for (UInt32 i = 0; i < 100000U; ++i) {
+        if (!(readReg(R_MSDC_CFG) & CFG_RST)) { resetDone = true; break; }
+        delayUS(1);
+    }
+    if (!resetDone) return kIOReturnTimeout;
+
+    cfg = readReg(R_MSDC_CFG);
+    cfg &= ~(CFG_CKDIV_MASK | CFG_CKMOD_MASK);
+    cfg |= CFG_MODE | CFG_PIO;
+    writeReg(R_MSDC_CFG, cfg);
+    writeReg(R_MSDC_IOCON, 0U);
+    writeReg(R_MSDC_INTEN, 0U);
+    writeReg(R_MSDC_INT, readReg(R_MSDC_INT));
+    writeReg(R_MSDC_FIFOCS, FIFO_CLR);
+
+    UInt32 sdc = readReg(R_SDC_CFG);
+    sdc &= ~(SDC_BUSWIDTH_MASK | SDC_DTOC_MASK);
+    sdc |= (0xffU << 24);
+    writeReg(R_SDC_CFG, sdc);
+    IOReturn result = setClock(400000U);
+    if (result != kIOReturnSuccess) return result;
+
+    result = command(CMD0_GO_IDLE, 0U, RSP_NONE, 0);
+    if (result != kIOReturnSuccess) return result;
+
+    if (sdCard) {
+        /* SD memory-card initialization: CMD55/ACMD41, then card-assigned RCA. */
+        bool ready = false;
+        for (UInt32 attempt = 0; attempt < 100U; ++attempt) {
+            result = command(CMD55_APP_CMD, 0U, RSP_R1, response);
+            if (result != kIOReturnSuccess) return result;
+            result = command(ACMD41_SD_SEND_OP_COND, 0x40ff8000U,
+                             RSP_R3, response);
+            if (result != kIOReturnSuccess) return result;
+            if (response[0] & 0x80000000U) { ready = true; break; }
+            delayUS(10000U);
+        }
+        if (!ready) return kIOReturnTimeout;
+        highCapacity = (response[0] & 0x40000000U) != 0;
+
+        result = command(CMD2_ALL_SEND_CID, 0U, RSP_R2, response);
+        if (result != kIOReturnSuccess) return result;
+        result = command(CMD3_SET_RCA, 0U, RSP_R1, response);
+        if (result != kIOReturnSuccess) return result;
+        rca = response[0] & 0xffff0000U;
+        if (!rca) return kIOReturnIOError;
+        result = command(CMD7_SELECT_CARD, rca, RSP_R1B, response);
+        if (result != kIOReturnSuccess) return result;
+        if (!highCapacity) {
+            result = command(CMD16_SET_BLOCKLEN, 512U, RSP_R1, response);
+            if (result != kIOReturnSuccess) return result;
+        }
+
+        result = command(CMD9_SEND_CSD, rca, RSP_R2, response);
+        if (result != kIOReturnSuccess) return result;
+        UInt32 csdStructure = response[0] >> 30;
+        if (highCapacity) {
+            if (csdStructure != 1U) return kIOReturnUnsupported;
+            UInt32 cSize = ((response[1] & 0x3fU) << 16) |
+                           (response[2] >> 16);
+            sectors = ((UInt64)cSize + 1U) * 1024U;
+        } else {
+            if (csdStructure != 0U) return kIOReturnUnsupported;
+            UInt32 readBlockLength = (response[1] >> 16) & 0x0fU;
+            UInt32 cSize = ((response[1] & 0x3ffU) << 2) |
+                           (response[2] >> 30);
+            UInt32 cSizeMult = (response[2] >> 15) & 0x07U;
+            UInt64 capacityBytes = ((UInt64)cSize + 1U) << (cSizeMult + 2U);
+            capacityBytes <<= readBlockLength;
+            sectors = capacityBytes / 512U;
+        }
+        if (!sectors) return kIOReturnUnsupported;
+        result = setClock(25000000U);
+        if (result != kIOReturnSuccess) return result;
+        return kIOReturnSuccess;
+    }
+
+    bool ready = false;
+    for (UInt32 attempt = 0; attempt < 100U; ++attempt) {
+        result = command(CMD1_SEND_OP_COND, 0x40ff8000U, RSP_R3, response);
+        if (result != kIOReturnSuccess) return result;
+        if (response[0] & 0x80000000U) { ready = true; break; }
+        delayUS(10000U);
+    }
+    if (!ready) return kIOReturnTimeout;
+
+    result = command(CMD2_ALL_SEND_CID, 0U, RSP_R2, response);
+    if (result != kIOReturnSuccess) return result;
+    rca = 1U << 16;
+    result = command(CMD3_SET_RCA, rca, RSP_R1, response);
+    if (result != kIOReturnSuccess) return result;
+    result = command(CMD7_SELECT_CARD, rca, RSP_R1B, response);
+    if (result != kIOReturnSuccess) return result;
+
+    result = dataCommand(CMD8_SEND_EXT_CSD, 0U, RSP_R1, extCsd,
+                        sizeof(extCsd));
+    if (result != kIOReturnSuccess) return result;
+    sectors = (UInt64)extCsd[212] |
+              ((UInt64)extCsd[213] << 8) |
+              ((UInt64)extCsd[214] << 16) |
+              ((UInt64)extCsd[215] << 24);
+    if (!sectors) return kIOReturnUnsupported;
+
+    result = setClock(25000000U);
+    if (result != kIOReturnSuccess) return result;
+    return kIOReturnSuccess;
+}
+
+IOReturn IOS7TB3MSDC::readSector(UInt64 sector, UInt8 *bytes)
+{
+    if (!initialized || faulted || sector >= sectors) return kIOReturnNotReady;
+    UInt64 argument = sector;
+    if (sdCard && !highCapacity) {
+        if (sector > 0xffffffffULL / 512U) return kIOReturnUnsupported;
+        argument = sector * 512U;
+    }
+    if (argument > 0xffffffffULL) return kIOReturnUnsupported;
+    IOReturn result = dataCommand(CMD17_READ_SINGLE, (UInt32)argument,
+                                  RSP_R1, bytes, 512U);
+    /* A timeout/CRC error may leave the controller's data path busy. Do not
+     * issue a second command against an unknown host/card state. */
+    if (result != kIOReturnSuccess) faulted = true;
+    return result;
+}
+
+IOReturn IOS7TB3MSDC::doAsyncReadWrite(IOMemoryDescriptor *buffer,
+                                       UInt64 block, UInt64 count,
+                                       IOStorageAttributes *attributes,
+                                       IOStorageCompletion *completion)
+{
+    if (!buffer || !completion || !completion->action || !initialized ||
+        faulted ||
+        !count || block >= sectors || count > sectors - block ||
+        count > 0xffffffffULL / 512U ||
+        buffer->getLength() != count * 512U)
+        return kIOReturnBadArgument;
+    if (buffer->getDirection() != kIODirectionIn)
+        return kIOReturnNotWritable;
+    if (attributes && (attributes->options || attributes->reserved0032 ||
+                       attributes->reserved0064))
+        return kIOReturnUnsupported;
+
+    IOStorageCompletion saved = *completion;
+    UInt8 sectorBuffer[512];
+    UInt64 completed = 0;
+    IOReturn result = kIOReturnSuccess;
+    IOLockLock(lock);
+    for (UInt64 index = 0; index < count; ++index) {
+        result = readSector(block + index, sectorBuffer);
+        if (result != kIOReturnSuccess) break;
+        if (buffer->writeBytes((IOByteCount)completed, sectorBuffer,
+                               sizeof(sectorBuffer)) != sizeof(sectorBuffer)) {
+            result = kIOReturnUnderrun;
+            break;
+        }
+        completed += sizeof(sectorBuffer);
+    }
+    IOLockUnlock(lock);
+    IOStorage::complete(&saved, result, completed);
+    return kIOReturnSuccess;
+}
+
+char *IOS7TB3MSDC::getVendorString() { static char s[] = "MediaTek"; return s; }
+char *IOS7TB3MSDC::getProductString() { static char e[] = "MT8127 eMMC"; static char s[] = "TB3 microSD"; return sdCard ? s : e; }
+char *IOS7TB3MSDC::getRevisionString() { static char s[] = "PIO-RO"; return s; }
+char *IOS7TB3MSDC::getAdditionalDeviceInfoString() { static char e[] = "MSDC0"; static char s[] = "MSDC1"; return sdCard ? s : e; }
+IOReturn IOS7TB3MSDC::reportBlockSize(UInt64 *v) { if (!v) return kIOReturnBadArgument; *v = 512U; return kIOReturnSuccess; }
+IOReturn IOS7TB3MSDC::reportMaxValidBlock(UInt64 *v) { if (!v || !initialized || faulted || !sectors) return kIOReturnNotReady; *v = sectors - 1U; return kIOReturnSuccess; }
+IOReturn IOS7TB3MSDC::reportEjectability(bool *v) { if (!v) return kIOReturnBadArgument; *v = false; return kIOReturnSuccess; }
+IOReturn IOS7TB3MSDC::reportLockability(bool *v) { if (!v) return kIOReturnBadArgument; *v = false; return kIOReturnSuccess; }
+IOReturn IOS7TB3MSDC::reportRemovability(bool *v) { if (!v) return kIOReturnBadArgument; *v = false; return kIOReturnSuccess; }
+IOReturn IOS7TB3MSDC::reportMediaState(bool *p, bool *c) { if (!p || !c) return kIOReturnBadArgument; *p = initialized && !faulted; *c = false; return kIOReturnSuccess; }
+IOReturn IOS7TB3MSDC::reportPollRequirements(bool *r, bool *e) { if (!r || !e) return kIOReturnBadArgument; *r = false; *e = false; return kIOReturnSuccess; }
+IOReturn IOS7TB3MSDC::reportWriteProtection(bool *v) { if (!v) return kIOReturnBadArgument; *v = true; return kIOReturnSuccess; }
+
+extern "C" void tb3_mmc_register(IOService *platform)
+{
+    int sdEnabled = 0, emmcEnabled = 0;
+    PE_parse_boot_argn("tb3_sd", &sdEnabled, sizeof(sdEnabled));
+    PE_parse_boot_argn("tb3_emmc", &emmcEnabled, sizeof(emmcEnabled));
+    if (!sdEnabled && !emmcEnabled) return;
+
+    IOS7TB3MSDC *device = new IOS7TB3MSDC;
+    if (!device) { IOLog("TB3 MSDC: allocation failed\n"); return; }
+    if (sdEnabled) device->selectSDCard();
+    bool attached = false, success = false;
+    if (device->init()) attached = device->attach(platform);
+    if (attached && device->start(platform)) {
+        OSObject *decoded = OSUnserializeXML(ios7labStoragePersonalities);
+        OSArray *drivers = OSDynamicCast(OSArray, decoded);
+        if (drivers && gIOCatalogue && gIOCatalogue->addDrivers(drivers, false)) {
+            device->registerService();
+            success = true;
+        }
+        if (decoded) decoded->release();
+    }
+    if (!success) IOLog("TB3 MSDC: opt-in driver did not start\n");
+    if (attached && !success) device->detach(platform);
+    device->release();
+}
+#endif
