+ *
+ * Uses GPT6 as a 64-bit, 13 MHz free-running timebase and GPT1 as the
+ * one-shot clock event.  The GPT interrupt is GIC INTID 144.  Register
+ * definitions and clock rate follow the Lenovo MT8127 kernel sources.
+ */
+#include <mach/mach_types.h>
+#include <mach/arm/thread_status.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm/protos.h>
+#include <machine/machine_routines.h>
+#include <kern/debug.h>
+#include <kern/clock.h>
+#include "mt8127_tb3_timer.h"
+
+#if defined(BOARD_CONFIG_MT8127_TB3)
+#define TB3_GPT_PA             0x10008000U
+#define TB3_GIC_DIST_PA        0x10211000U
+#define TB3_GIC_CPU_PA         0x10212000U
+#define TB3_IO_BYTES           0x1000U
+
+#define GPT_IRQEN              0x000U
+#define GPT_IRQSTA             0x004U
+#define GPT_IRQACK             0x008U
+#define GPT1_BASE              0x010U
+#define GPT6_BASE              0x060U
+#define GPT_CON                0x000U
+#define GPT_CLK                0x004U
+#define GPT_CNT                0x008U
+#define GPT_CMP                0x00CU
+#define GPT_CNTH               0x018U
+#define GPT_CMPH               0x01CU
+#define GPT_CON_ENABLE         (1U << 0)
+#define GPT_CON_CLRCNT         (1U << 1)
+#define GPT_CON_OPMODE         (3U << 4)
+#define GPT_MODE_ONE_SHOT      0U
+#define GPT_MODE_FREE_RUN      3U
+
+#define GICD_CTLR              0x000U
+#define GICD_ISENABLER         0x100U
+#define GICD_ICENABLER         0x180U
+#define GICD_ICPENDR           0x280U
+#define GICD_IPRIORITYR        0x400U
+#define GICD_ITARGETSR         0x800U
+#define GICD_ICFGR             0xC00U
+#define GICC_CTLR              0x000U
+#define GICC_PMR               0x004U
+#define GICC_IAR               0x00CU
+#define GICC_EOIR              0x010U
+
+extern void rtc_configure(uint64_t hz);
+extern void rtclock_intr(arm_saved_state_t *regs);
+
+uint64_t clock_decrementer;
+static vm_offset_t tb3_gpt, tb3_gic_dist, tb3_gic_cpu;
+static uint32_t tb3_gic_ready, tb3_timebase_ready, tb3_timer_armed;
+static uint32_t tb3_irq_count, tb3_last_irq, tb3_last_vector;
+static uint32_t tb3_spurious_count;
+
+static uint32_t read_reg(vm_offset_t base, uint32_t offset)
+{
+    return *(volatile uint32_t *)(base + offset);
+}
+
+static void write_reg(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+    *(volatile uint32_t *)(base + offset) = value;
+}
+
+static void drain_writes(void)
+{
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint64_t gpt6_read(void)
+{
+    uint32_t hi, lo, hi2;
+    do {
+        hi = read_reg(tb3_gpt, GPT6_BASE + GPT_CNTH);
+        lo = read_reg(tb3_gpt, GPT6_BASE + GPT_CNT);
+        hi2 = read_reg(tb3_gpt, GPT6_BASE + GPT_CNTH);
+    } while (hi != hi2);
+    return ((uint64_t)hi2 << 32) | lo;
+}
+
+static void gpt_reset(uint32_t base, uint32_t id, int is64)
+{
+    uint32_t irq = 1U << id;
+    write_reg(tb3_gpt, base + GPT_CON, 0U);
+    write_reg(tb3_gpt, GPT_IRQEN, read_reg(tb3_gpt, GPT_IRQEN) & ~irq);
+    write_reg(tb3_gpt, GPT_IRQACK, irq);
+    write_reg(tb3_gpt, base + GPT_CLK, 0U); /* SYS clock, divide by one. */
+    write_reg(tb3_gpt, base + GPT_CON, GPT_CON_CLRCNT);
+    write_reg(tb3_gpt, base + GPT_CMP, 0U);
+    if (is64)
+        write_reg(tb3_gpt, base + GPT_CMPH, 0U);
+}
+
+void TB3_interrupt_init(void)
+{
+    boolean_t was_enabled = ml_set_interrupts_enabled(FALSE);
+    uint32_t i, irq = TB3_GPT_IRQ;
+    uint32_t priority_offset, target_offset, config_offset;
+    uint32_t shift;
+
+    if (tb3_gic_ready) {
+        ml_set_interrupts_enabled(was_enabled);
+        return;
+    }
+    tb3_gic_dist = ml_io_map(TB3_GIC_DIST_PA, TB3_IO_BYTES);
+    tb3_gic_cpu = ml_io_map(TB3_GIC_CPU_PA, TB3_IO_BYTES);
+    tb3_gpt = ml_io_map(TB3_GPT_PA, 0x1000U);
+    if (!tb3_gic_dist || !tb3_gic_cpu || !tb3_gpt)
+        panic("TB3 GIC/GPT IO mapping failed");
+
+    write_reg(tb3_gic_dist, GICD_CTLR, 0U);
+    for (i = 0; i < 8; i++) {
+        write_reg(tb3_gic_dist, GICD_ICENABLER + i * 4, 0xffffffffU);
+        write_reg(tb3_gic_dist, GICD_ICPENDR + i * 4, 0xffffffffU);
+    }
+
+    priority_offset = GICD_IPRIORITYR + (irq / 4U) * 4U;
+    shift = (irq % 4U) * 8U;
+    write_reg(tb3_gic_dist, priority_offset,
+        (read_reg(tb3_gic_dist, priority_offset) & ~(0xffU << shift)) |
+        (0x80U << shift));
+
+    /* GPT1 is a level-sensitive SPI routed to CPU0. */
+    target_offset = GICD_ITARGETSR + (irq / 4U) * 4U;
+    shift = (irq % 4U) * 8U;
+    write_reg(tb3_gic_dist, target_offset,
+        (read_reg(tb3_gic_dist, target_offset) & ~(0xffU << shift)) |
+        (0x01U << shift));
+    config_offset = GICD_ICFGR + (irq / 16U) * 4U;
+    shift = (irq % 16U) * 2U;
+    write_reg(tb3_gic_dist, config_offset,
+        read_reg(tb3_gic_dist, config_offset) & ~(3U << shift));
+
+    write_reg(tb3_gic_cpu, GICC_PMR, 0xf0U);
+    write_reg(tb3_gic_cpu, GICC_CTLR, 1U);
+    write_reg(tb3_gic_dist, GICD_CTLR, 1U);
+    drain_writes();
+    tb3_gic_ready = 1U;
+    ml_set_interrupts_enabled(was_enabled);
+}
+
+void TB3_timebase_init(void)
+{
+    uint32_t i;
+    uint64_t before, after;
+    boolean_t was_enabled = ml_set_interrupts_enabled(FALSE);
+
+    if (!tb3_gic_ready)
+        panic("TB3 timebase before GIC initialization");
+    if (tb3_timebase_ready) {
+        ml_set_interrupts_enabled(was_enabled);
+        return;
+    }
+
+    /* GPT6 is the vendor kernel's 64-bit system counter. */
+    gpt_reset(GPT6_BASE, 5U, 1);
+    write_reg(tb3_gpt, GPT6_BASE + GPT_CON,
+        (GPT_MODE_FREE_RUN << 4) | GPT_CON_CLRCNT);
+    for (i = 0; i < 0x10000U && read_reg(tb3_gpt, GPT6_BASE + GPT_CNT); i++) { }
+    write_reg(tb3_gpt, GPT6_BASE + GPT_CON,
+        (GPT_MODE_FREE_RUN << 4) | GPT_CON_ENABLE);
+
+    before = gpt6_read();
+    after = before;
+    for (i = 0; i < 0x10000U && after == before; i++)
+        after = gpt6_read();
+    if (after == before)
+        panic("TB3 GPT6 counter did not advance");
+
+    tb3_timebase_ready = 1U;
+    clock_decrementer = TB3_GPT_HZ / 100U;
+    gPEClockFrequencyInfo.timebase_frequency_hz = TB3_GPT_HZ;
+    gPEClockFrequencyInfo.dec_clock_rate_hz = TB3_GPT_HZ;
+    rtc_configure(TB3_GPT_HZ);
+    TB3_timer_enabled(TRUE);
+    ml_set_interrupts_enabled(was_enabled);
+}
+
+void TB3_timer_enabled(int enable)
+{
+    uint32_t ticks, con;
+    uint32_t bit = 1U; /* GPT1, id 0. */
+    boolean_t was_enabled = ml_set_interrupts_enabled(FALSE);
+
+    if (!tb3_timebase_ready)
+        panic("TB3 timer before timebase initialization");
+    if (!enable) {
+        con = read_reg(tb3_gpt, GPT1_BASE + GPT_CON);
+        write_reg(tb3_gpt, GPT1_BASE + GPT_CON, con & ~GPT_CON_ENABLE);
+        write_reg(tb3_gpt, GPT_IRQEN, read_reg(tb3_gpt, GPT_IRQEN) & ~bit);
+        write_reg(tb3_gic_dist,
+            GICD_ICENABLER + (TB3_GPT_IRQ / 32U) * 4U,
+            1U << (TB3_GPT_IRQ % 32U));
+        write_reg(tb3_gpt, GPT_IRQACK, bit);
+        tb3_timer_armed = 0U;
+        drain_writes();
+        ml_set_interrupts_enabled(was_enabled);
+        return;
+    }
+
+    ticks = clock_decrementer > 0x7fffffffULL ? 0x7fffffffU :
+        (uint32_t)clock_decrementer;
+    if (ticks < 4U)
+        ticks = 4U;
+
+    con = read_reg(tb3_gpt, GPT1_BASE + GPT_CON);
+    write_reg(tb3_gpt, GPT1_BASE + GPT_CON, con & ~GPT_CON_ENABLE);
+    write_reg(tb3_gpt, GPT_IRQEN, read_reg(tb3_gpt, GPT_IRQEN) & ~bit);
+    write_reg(tb3_gpt, GPT_IRQACK, bit);
+    write_reg(tb3_gic_dist,
+        GICD_ICPENDR + (TB3_GPT_IRQ / 32U) * 4U,
+        1U << (TB3_GPT_IRQ % 32U));
+
+    write_reg(tb3_gpt, GPT1_BASE + GPT_CLK, 0U);
+    write_reg(tb3_gpt, GPT1_BASE + GPT_CMP, ticks);
+    write_reg(tb3_gpt, GPT1_BASE + GPT_CON, GPT_CON_CLRCNT);
+    write_reg(tb3_gpt, GPT1_BASE + GPT_CON, GPT_CON_ENABLE);
+    write_reg(tb3_gpt, GPT_IRQEN, read_reg(tb3_gpt, GPT_IRQEN) | bit);
+    write_reg(tb3_gic_dist,
+        GICD_ISENABLER + (TB3_GPT_IRQ / 32U) * 4U,
+        1U << (TB3_GPT_IRQ % 32U));
+    write_reg(tb3_gic_cpu, GICC_CTLR, 1U);
+    write_reg(tb3_gic_dist, GICD_CTLR, 1U);
+    drain_writes();
+    tb3_timer_armed = 1U;
+    ml_set_interrupts_enabled(was_enabled);
+}
+
+uint64_t TB3_get_timebase(void)
+{
+    return tb3_timebase_ready ? gpt6_read() : 0U;
+}
+
+uint64_t TB3_timer_value(void)
+{
+    uint32_t count, compare;
+    if (!tb3_timebase_ready || !tb3_timer_armed)
+        return 0U;
+    count = read_reg(tb3_gpt, GPT1_BASE + GPT_CNT);
+    compare = read_reg(tb3_gpt, GPT1_BASE + GPT_CMP);
+    return count < compare ? compare - count : 0U;
+}
+
+void TB3_handle_interrupt(void *context)
+{
+    uint32_t ack, irq, budget;
+    if (!tb3_gic_ready || !tb3_timebase_ready)
+        panic("TB3 IRQ before GIC/timebase initialization");
+
+    for (budget = 0; budget < 32U; budget++) {
+        ack = read_reg(tb3_gic_cpu, GICC_IAR);
+        irq = ack & 0x3ffU;
+        tb3_last_vector = irq;
+        if (irq >= 1020U) {
+            if (budget == 0U)
+                tb3_spurious_count++;
+            return;
+        }
+        if (irq != TB3_GPT_IRQ) {
+            write_reg(tb3_gic_cpu, GICC_EOIR, ack);
+            panic("TB3 unexpected IRQ %u", irq);
+        }
+
+        /* Clear the MediaTek GPT source before completing its GIC interrupt. */
+        write_reg(tb3_gpt, GPT_IRQACK, 1U);
+        write_reg(tb3_gic_cpu, GICC_EOIR, ack);
+        drain_writes();
+        tb3_last_irq = (uint32_t)gpt6_read();
+        tb3_irq_count++;
+        rtclock_intr((arm_saved_state_t *)context);
+#if !CONFIG_TICKLESS
+        TB3_timer_enabled(TRUE);
+#endif
+    }
+    panic("TB3 GIC IRQ drain budget exceeded");
+}
+#endif
diff --git a/xnu/pexpert/arm/mt8127_tb3_timer.h b/xnu/pexpert/arm/mt8127_tb3_timer.h
