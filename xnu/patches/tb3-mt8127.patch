+++ b/xnu/osfmk/arm/arm_vm_init.c
@@ -367,6 +367,23 @@ void arm_vm_init(uint32_t mem_limit, boot_args * args)
             l1[devs[idx]] = (devs[idx] << 20) | 0xC02;
     }
 #endif
+#ifdef BOARD_CONFIG_MT8127_TB3
+    /* MT8127 TB3-710F: preserve LK's scanout buffer and the SoC
+     * UART/GPT/GIC windows while replacing the bootstrap page tables.
+     * Physical addresses come from the Lenovo MT8127 kernel map and the
+     * observed /proc/iomem framebuffer reservation. */
+    {
+        volatile unsigned int *l1 =
+            (volatile unsigned int *)phys_to_virt(cpu_ttb);
+        const unsigned int devs[] = { 0x100, 0x102, 0x110 };
+        unsigned int idx;
