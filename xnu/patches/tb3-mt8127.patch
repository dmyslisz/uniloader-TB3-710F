diff --git a/xnu/pexpert/arm/pe_mt8127_tb3.c b/xnu/pexpert/arm/pe_mt8127_tb3.c
new file mode 100644
index 0000000..d7c9a9d
--- /dev/null
+++ b/xnu/pexpert/arm/pe_mt8127_tb3.c
@@ -0,0 +1,112 @@
+/* Lenovo TB3-710F / MediaTek MT8127 platform expert. */
+#if defined(BOARD_CONFIG_MT8127_TB3)
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm/boot.h>
+#include <pexpert/arm/protos.h>
+#include <machine/machine_routines.h>
+#include <kern/debug.h>
+#include "mt8127_tb3_timer.h"
+
+#define TB3_UART_PA       0x11002000U
+#define TB3_UART_BYTES    0x1000U
+#define TB3_UART_THR      0x00U
+#define TB3_UART_RBR      0x00U
+#define TB3_UART_LSR      0x14U
+#define TB3_UART_LSR_DR   (1U << 0)
+#define TB3_UART_LSR_THRE (1U << 5)
+#define TB3_FB_PA         0xBEE00000U
+#define TB3_FB_BYTES      (1024U * 600U * 2U)
+#define TB3_FB_MAP_BYTES  0x200000U
+
+static vm_offset_t tb3_uart_map;
+static vm_offset_t tb3_fb_map;
+
+void tb3_uart_putc(char c)
+{
+    volatile uint32_t *uart;
+    uint32_t i;
+    if (tb3_uart_map)
+        uart = (volatile uint32_t *)tb3_uart_map;
+    else
+        uart = (volatile uint32_t *)TB3_UART_PA;
+    for (i = 0; i < 100000U; i++)
+        if (uart[TB3_UART_LSR / 4U] & TB3_UART_LSR_THRE)
+            break;
+    if (i < 100000U)
+        uart[TB3_UART_THR / 4U] = (uint32_t)(uint8_t)c;
+}
+
+static int tb3_uart_getc(void)
+{
+    volatile uint32_t *uart = (volatile uint32_t *)tb3_uart_map;
+    if (!uart || !(uart[TB3_UART_LSR / 4U] & TB3_UART_LSR_DR))
+        return -1;
+    return (int)(uart[TB3_UART_RBR / 4U] & 0xffU);
+}
+
+static void tb3_uart_init(void) { }
+
+static void tb3_framebuffer_init(void)
+{
+    boot_args *args = (boot_args *)PE_state.bootArgs;
+    PE_Video video;
+    volatile uint16_t *pixels;
+    uint32_t x, y;
+
+    if (!args || args->Video.v_baseAddr != TB3_FB_PA ||
+        args->Video.v_width != 1024U || args->Video.v_height != 600U ||
+        args->Video.v_rowBytes != 2048U || args->Video.v_depth != 16U)
+        panic("TB3 XNU framebuffer handoff mismatch");
+
+    tb3_fb_map = ml_io_map(TB3_FB_PA, TB3_FB_MAP_BYTES);
+    tb3_uart_map = ml_io_map(TB3_UART_PA, TB3_UART_BYTES);
+    if (!tb3_fb_map || !tb3_uart_map)
+        panic("TB3 framebuffer/UART mapping failed");
+
+    PE_state.video.v_baseAddr = tb3_fb_map;
+    PE_state.video.v_rowBytes = 2048U;
+    PE_state.video.v_width = 1024U;
+    PE_state.video.v_height = 600U;
+    PE_state.video.v_depth = 16U;
+
+    video = PE_state.video;
+    video.v_baseAddr = TB3_FB_PA | 1U;
+    video.v_baseAddrHigh = 0U;
+    video.v_offset = 0U;
+    video.v_length = TB3_FB_BYTES;
+    video.v_width = 1024U;
+    video.v_height = 600U;
+    video.v_rowBytes = 2048U;
+    video.v_depth = 16U;
+    video.v_scale = kPEScaleFactor1x;
+    initialize_screen(&video, kPETextMode);
+
+    /* Small post-console RGB565 marker: proves XNU, not just uniLoader,
+     * reached the MT8127 platform-expert framebuffer path. */
+    pixels = (volatile uint16_t *)tb3_fb_map;
+    for (y = 0; y < 8U; y++) {
+        for (x = 0; x < 96U; x++) {
+            uint16_t color = x < 32U ? 0xf800U :
+                             (x < 64U ? 0x07e0U : 0x001fU);
+            pixels[y * 1024U + x] = color;
+        }
+    }
+}
+
+void PE_init_SocSupport_stub(void)
+{
+    gPESocDispatch.uart_getc = tb3_uart_getc;
+    gPESocDispatch.uart_putc = tb3_uart_putc;
+    gPESocDispatch.uart_init = tb3_uart_init;
+    gPESocDispatch.interrupt_init = TB3_interrupt_init;
+    gPESocDispatch.timebase_init = TB3_timebase_init;
+    gPESocDispatch.handle_interrupt = TB3_handle_interrupt;
+    gPESocDispatch.get_timebase = TB3_get_timebase;
+    gPESocDispatch.timer_value = TB3_timer_value;
+    gPESocDispatch.timer_enabled = TB3_timer_enabled;
+    gPESocDispatch.framebuffer_init = tb3_framebuffer_init;
+
+    tb3_framebuffer_init();
+}
+#endif
