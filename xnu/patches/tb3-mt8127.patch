+        for (idx = 0; idx < 2; idx++)
+            l1[0xBEE + idx] = (0xBEE00000u + idx * 0x100000u) | 0x402;
+        for (idx = 0; idx < sizeof(devs) / sizeof(devs[0]); idx++)
+            l1[devs[idx]] = (devs[idx] << 20) | 0xC02;
+    }
+#endif
 
